{
  "version": 8,
  "name": "GameMaps — GTA-inspired",
  "metadata": {
    "gamemaps:description": "Original high-contrast minimap style. Online OpenFreeMap tiles; no game assets."
  },
  "center": [12.5, 42.5],
  "zoom": 5,
  "bearing": 0,
  "pitch": 0,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/latest",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\">OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#292c30"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#34383c"
      }
    },
    {
      "id": "vegetation",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "scrub"],
      "paint": {
        "fill-color": "#35483d",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#3c5143",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#294d61"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 10,
      "paint": {
        "line-color": "#294d61",
        "line-width": {
          "stops": [[10, 0.6], [16, 3]]
        }
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#4b4e52",
        "fill-outline-color": "#202326"
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 4],
      "paint": {
        "line-color": "#747b80",
        "line-width": 1,
        "line-dasharray": [3, 3],
        "line-opacity": 0.5
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["in", "class", "path", "track"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#959991",
        "line-width": {
          "stops": [[12, 0.5], [18, 2]]
        },
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "tunnel-local-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "minor", "service"], ["==", "brunnel", "tunnel"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#17191c",
        "line-opacity": 0.45,
        "line-width": {
          "stops": [[10, 2.2], [14, 4.5], [18, 14]]
