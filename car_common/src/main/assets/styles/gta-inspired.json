      "paint": {
        "line-color": "#92948e",
        "line-width": 1,
        "line-dasharray": [2, 3]
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-angle": 30,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "#f6f4e8",
        "text-halo-color": "#202326",
        "text-halo-width": 1.5
      }
    },
