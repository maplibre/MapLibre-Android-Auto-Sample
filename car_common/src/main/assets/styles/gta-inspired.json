      "id": "places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village"],
      "minzoom": 5,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": {
          "stops": [[5, 12], [12, 16], [16, 20]]
        },
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-max-width": 9
      },
